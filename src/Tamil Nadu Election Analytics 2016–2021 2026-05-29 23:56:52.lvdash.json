    {
      "name": "results_with_alliance",
      "displayName": "results_with_alliance",
      "config": {
        "version": "1.1",
        "source": "SELECT \n  fr.Constituency,\n  fr.Year,\n  fr.Winner,\n  fr.Winner_Party,\n  fr.Runner_up,\n  fr.RunnerUp_Party,\n  fr.Margin,\n  fr.Margin_Category,\n  dp.Alliance as Winner_Alliance\nFROM workspace.bronze_layer.fact_results fr LEFT JOIN workspace.bronze_layer.dim_party dp ON fr.Winner_Party = dp.PartyName\n",
        "dimensions": [
          {
            "name": "Constituency",
            "expr": "Constituency",
            "displayName": "Constituency"
          },
          {
            "name": "Year",
            "expr": "Year",
            "displayName": "Year"
          },
          {
            "name": "Winner",
            "expr": "Winner",
            "displayName": "Winner"
          },
          {
            "name": "Winner_Party",
            "expr": "Winner_Party",
            "displayName": "Winner Party"
          },
          {
            "name": "Runner_up",
            "expr": "Runner_up",
            "displayName": "Runner Up"
          },
          {
            "name": "RunnerUp_Party",
            "expr": "RunnerUp_Party",
            "displayName": "Runner Up Party"
          },
          {
            "name": "Margin",
            "expr": "Margin",
            "displayName": "Margin"
          },
          {
            "name": "Margin_Category",
            "expr": "Margin_Category",
            "displayName": "Margin Category"
          },
          {
            "name": "Winner_Alliance",
            "expr": "Winner_Alliance",
            "displayName": "Winner Alliance"
          }
        ],
        "measures": [
          {
            "name": "constituencies_won",
            "expr": "COUNT(DISTINCT Constituency)",
            "displayName": "Constituencies Won"
          },
          {
            "name": "total_contests",
            "expr": "COUNT(*)",
            "displayName": "Total Contests"
          }
        ]
      }
    },
    {
      "name": "votes_with_alliance",
      "displayName": "votes_with_alliance",
      "config": {
        "version": "1.1",
        "source": "SELECT \n  fv.Constituency,\n  fv.Year,\n  fv.Party,\n  fv.Votes,\n  fv.Vote_Percent,\n  dp.Alliance\nFROM workspace.bronze_layer.fact_votes fv LEFT JOIN workspace.bronze_layer.dim_party dp ON fv.Party = dp.PartyName\n",
        "dimensions": [
          {
            "name": "Constituency",
            "expr": "Constituency",
            "displayName": "Constituency"
          },
          {
            "name": "Year",
            "expr": "Year",
            "displayName": "Year"
          },
          {
            "name": "Party",
            "expr": "Party",
            "displayName": "Party"
          },
          {
            "name": "Alliance",
            "expr": "Alliance",
            "displayName": "Alliance"
          }
        ],
        "measures": [
          {
            "name": "total_votes",
            "expr": "SUM(Votes)",
            "displayName": "Total Votes"
          },
          {
            "name": "avg_vote_percent",
            "expr": "AVG(Vote_Percent)",
            "displayName": "Average Vote Percent"
          }
        ]
      }
    },
    {
      "name": "top_10_close",
      "displayName": "Top 10 Closest Contests",
      "config": {
        "version": "1.1",
        "source": "SELECT \n  Constituency,\n  Year,\n  Winner,\n  Winner_Party,\n  Margin\nFROM workspace.bronze_layer.fact_results WHERE Margin IS NOT NULL ORDER BY Margin ASC LIMIT 10\n",
        "dimensions": [
          {
            "name": "Constituency",
            "expr": "Constituency"
          },
          {
            "name": "Year",
            "expr": "Year"
          },
          {
            "name": "Winner",
            "expr": "Winner"
          },
          {
            "name": "Winner_Party",
            "expr": "Winner_Party"
          },
          {
            "name": "Margin",
            "expr": "Margin"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)"
          }
        ]
      }
    },
    {
      "name": "alliance_votes_by_year",
      "displayName": "Alliance Votes by Year",
      "config": {
        "version": "1.1",
        "source": "SELECT \n  fv.Year,\n  fv.Constituency,\n  fv.Party,\n  fv.Votes,\n  dp.Alliance\nFROM workspace.bronze_layer.fact_votes fv LEFT JOIN workspace.bronze_layer.dim_party dp ON fv.Party = dp.PartyName\n",
        "dimensions": [
          {
            "name": "Year",
            "expr": "Year",
            "displayName": "Year"
          },
          {
            "name": "Alliance",
            "expr": "Alliance",
            "displayName": "Alliance"
          }
        ],
        "measures": [
          {
            "name": "alliance_votes",
            "expr": "SUM(Votes)",
            "displayName": "Alliance Votes",
            "comment": "Total votes secured by alliance"
          }
        ]
      }
    },
    {
      "name": "votes_by_year",
      "displayName": "Votes by Year (State Level)",
      "config": {
        "version": "1.1",
        "source": "SELECT \n  Year,\n  Constituency,\n  SUM(Votes) as constituency_votes\nFROM workspace.bronze_layer.fact_votes GROUP BY Year, Constituency\n",
        "dimensions": [
          {
            "name": "Year",
            "expr": "Year",
            "displayName": "Year"
          },
          {
            "name": "Constituency",
            "expr": "Constituency",
            "displayName": "Constituency"
          }
        ],
        "measures": [
          {
            "name": "total_votes_state",
            "expr": "SUM(constituency_votes)",
            "displayName": "Total Votes (State Level)",
            "comment": "Sum of constituency-level vote totals to get state-level total without double-counting"
          }
        ]
      }
    }
  ],
