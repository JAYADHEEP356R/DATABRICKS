{
  "datasets": [
    {
      "name": "9f810653",
      "displayName": "fact_votes",
      "config": {
        "version": "1.1",
        "source": "workspace.bronze_layer.fact_votes",
        "dimensions": [
          {
            "name": "Constituency",
            "expr": "source.Constituency",
            "displayName": "Constituency"
          },
          {
            "name": "Year",
            "expr": "source.Year",
            "displayName": "Year"
          },
          {
            "name": "Party",
            "expr": "source.Party",
            "displayName": "Party"
          },
          {
            "name": "Vote_Percent",
            "expr": "source.Vote_Percent",
            "displayName": "Vote Percent"
          }
        ],
        "measures": [
          {
            "name": "total_votes",
            "expr": "SUM(source.Votes)",
            "displayName": "Total Votes"
          },
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset",
            "displayName": "Count"
          }
        ]
      }
    },
    {
      "name": "4d94d1c7",
      "displayName": "fact_results",
      "config": {
        "version": "1.1",
        "source": "workspace.bronze_layer.fact_results",
        "dimensions": [
          {
            "name": "Constituency",
            "expr": "source.Constituency",
            "displayName": "Constituency"
          },
          {
            "name": "Year",
            "expr": "source.Year",
            "displayName": "Year"
          },
          {
            "name": "Winner",
            "expr": "source.Winner",
            "displayName": "Winner"
          },
          {
            "name": "Winner_Party",
            "expr": "source.Winner_Party",
            "displayName": "Winner Party"
          },
          {
            "name": "Runner_up",
            "expr": "source.Runner_up",
            "displayName": "Runner Up"
          },
          {
            "name": "RunnerUp_Party",
            "expr": "source.RunnerUp_Party",
            "displayName": "Runner Up Party"
          },
          {
            "name": "Margin",
            "expr": "source.Margin",
            "displayName": "Margin"
          },
          {
            "name": "Margin_Category",
            "expr": "source.Margin_Category",
            "displayName": "Margin Category"
          }
        ],
        "measures": [
          {
            "name": "total_constituencies",
            "expr": "COUNT(DISTINCT source.Constituency)",
            "displayName": "Total Constituencies"
          },
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset",
            "displayName": "Count"
          },
          {
            "name": "close_contests",
            "expr": "SUM(CASE WHEN source.Margin_Category = 'Close' THEN 1 ELSE 0 END)",
            "displayName": "Close Contests"
          },
          {
            "name": "close_pct",
            "expr": "MEASURE(close_contests) * 100.0 / MEASURE(count)",
            "displayName": "Close Contests %"
          }
        ]
      }
    },
    {
      "name": "6d9d92cf",
